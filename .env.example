# Frontend/API connection
VITE_GAS_URL="https://script.google.com/macros/s/DEPLOYMENT_ID/exec"
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"

# Browser/API configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# API configuration
API_PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://hdos:change-me@localhost:5432/hdos
SESSION_TTL_HOURS=12

# Optional seed configuration
SEED_ADMIN_EMAIL=admin@ptcgg.com
SEED_ADMIN_PASSWORD="change-this-password-before-running-db-seed"
SEED_ADMIN_NAME="HDOS System Administrator"
